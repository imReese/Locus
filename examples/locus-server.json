{
  "listen": "0.0.0.0:8000",
  "http": {
    "listen_backlog": 2048,
    "max_connections": 4096,
    "tcp_nodelay": true,
    "tcp_keepalive_seconds": 60,
    "http1_keep_alive": true,
    "http1_header_read_timeout_millis": 10000,
    "http1_max_buffer_bytes": 65536,
    "http2_adaptive_window": true,
    "http2_max_concurrent_streams": 256,
    "http2_max_header_list_bytes": 65536,
    "http2_max_send_buffer_bytes": 65536,
    "http2_keep_alive_interval_millis": 30000,
    "http2_keep_alive_timeout_millis": 10000,
    "connection_shutdown_timeout_millis": 5000
  },
  "api": {
    "max_request_bytes": 2097152
  },
  "traffic": {
    "max_active_requests": 64,
    "max_active_tokens": 262144,
    "max_queued_requests": 512,
    "default_output_tokens": 256,
    "classes": [
      {
        "id": "latency",
        "weight": 4,
        "max_active_requests": 48,
        "max_active_tokens": 196608
      },
      {
        "id": "batch",
        "weight": 1,
        "max_active_requests": 16,
        "max_active_tokens": 65536,
        "shed_at_global_utilization_bps": 7500
      }
    ],
    "tenants": [
      {
        "id": "premium",
        "service_class": "latency",
        "weight": 4,
        "max_active_requests": 32,
        "max_active_tokens": 131072,
        "max_queued_requests": 256,
        "max_tokens_per_request": 32768,
        "default_request_timeout_millis": 60000,
        "max_request_timeout_millis": 120000,
        "bearer_token_env": "LOCUS_PREMIUM_API_KEY"
      },
      {
        "id": "batch",
        "service_class": "batch",
        "weight": 1,
        "max_active_requests": 8,
        "max_active_tokens": 32768,
        "max_queued_requests": 32,
        "max_tokens_per_request": 16384,
        "default_request_timeout_millis": 300000,
        "max_request_timeout_millis": 600000,
        "bearer_token_env": "LOCUS_BATCH_API_KEY"
      }
    ]
  },
  "models": [
    {
      "aliases": ["my-model"],
      "model_revision": "replace-with-immutable-model-revision",
      "execution_profile": "default",
      "tokenizer_json": "/models/my-model/tokenizer.json",
      "tokenizer_revision": "replace-with-tokenizer-revision",
      "chat_template": "/models/my-model/chat_template.jinja",
      "template_revision": "replace-with-template-revision",
      "template_context": {
        "bos_token": "<s>",
        "eos_token": "</s>"
      },
      "reasoning_parser": {
        "kind": "tagged",
        "revision": "replace-with-reasoning-parser-revision",
        "start_delimiter": "<think>",
        "end_delimiter": "</think>"
      },
      "tool_parser": {
        "kind": "tagged_json",
        "revision": "replace-with-tool-parser-revision",
        "start_delimiter": "<tool_call>",
        "end_delimiter": "</tool_call>",
        "max_buffered_bytes": 65536
      }
    }
  ],
  "engines": [
    {
      "id": "sglang-0",
      "kind": "sglang",
      "base_url": "http://127.0.0.1:30000",
      "runtime_version": "replace-with-sglang-version",
      "topology": "node-0/gpu-0",
      "hardware": "cuda",
      "telemetry": {
        "metrics_path": "/metrics",
        "request_timeout_millis": 2000,
        "min_scrape_interval_millis": 500,
        "valid_for_millis": 5000,
        "max_response_bytes": 2097152,
        "max_samples": 20000,
        "require_fresh_metrics": true
      },
      "tensor_parallel": 1,
      "pipeline_parallel": 1,
      "expert_parallel": 1
    },
    {
      "id": "vllm-0",
      "kind": "vllm",
      "base_url": "http://127.0.0.1:30001",
      "runtime_version": "replace-with-vllm-version",
      "topology": "node-1/gpu-0",
      "hardware": "cuda",
      "telemetry": {
        "metrics_path": "/metrics",
        "request_timeout_millis": 2000,
        "min_scrape_interval_millis": 500,
        "valid_for_millis": 5000,
        "max_response_bytes": 2097152,
        "max_samples": 20000,
        "require_fresh_metrics": true
      },
      "tensor_parallel": 1,
      "pipeline_parallel": 1,
      "expert_parallel": 1
    }
  ],
  "store": {
    "kind": "disabled"
  },
  "placement": {
    "mode": "shadow",
    "state_path": "/var/lib/locus/calibration.json",
    "calibration": {
      "min_samples_per_metric": 32,
      "max_mape_bps": 2500,
      "min_shadow_decisions": 128,
      "min_shadow_agreement_bps": 9500,
      "persistence_flush_every_updates": 16,
      "max_records": 4096,
      "max_materialization_paths_per_record": 256,
      "max_state_bytes": 33554432
    }
  },
  "observability": {
    "json": true,
    "filter": "locus=info,tower_http=info"
  },
  "shutdown": {
    "drain_timeout_millis": 30000,
    "force_cancel_grace_millis": 5000
  }
}
